    <!-- About -->
    <string name="about_title">About F7</string>
    <string name="about_tagline">A modern download manager. Fast, lightweight, no ads.</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_license">License</string>
    <string name="about_license_desc">This app is licensed under GNU GPL-3.0-or-later. Source code is available under the license terms.</string>
    <string name="about_inspiration">Inspired by Mister Download Manager (GPL-3.0), rebuilt natively for Android without using its desktop code.</string>
    <string name="about_features_title">What actually works</string>
    <string name="about_feature_multithread">Multi-connection segmented downloads with byte-level resume</string>
    <string name="about_feature_service">Background downloads through a foreground service and notifications</string>
    <string name="about_feature_hls">Non-DRM HLS video (VOD) including AES-128</string>
    <string name="about_feature_security">WebView browser with no local file access and no JavaScript bridge</string>
    <string name="about_feature_resume">Automatic recovery after the app closes or the process dies</string>
    <string name="about_not_included_title">Not included</string>
    <string name="about_not_included_desc">Torrent and magnet support is not included because it would significantly increase size and complexity. There are no fake buttons for it.</string>
    <string name="about_benchmark_title">Benchmark</string>
    <string name="about_benchmark_desc">Speed depends on the server and network. Tests were run against a local Range-capable server, including interrupted connections and app restarts. Full results are in the project documentation.</string>
    <string name="about_privacy_short">No account, no ads, no tracking.</string>
    <string name="about_thanks">Thanks to Material Symbols, Manrope, OkHttp, Room, and Jetpack Compose.</string>
    <string name="about_licenses">Third-party licenses</string>
    <string name="about_privacy">Privacy</string>
    <string name="about_privacy_desc">F7 sends no download data anywhere except to the servers you choose. There is no analytics and no advertising.</string>
    <string name="about_source_note">This release ships full source code as required by GPL-3.0. If you received the APK without access to the source, contact whoever provided it.</string>
    <string name="about_view_license">View the GPL-3.0 license text</string>
    <string name="about_libraries">Libraries: OkHttp (Apache-2.0), AndroidX, Room, Jetpack Compose (Apache-2.0), Manrope (OFL-1.1), Material Symbols (Apache-2.0).</string>
    <string name="about_copyright">Â© 2026 F7 Project. All trademarks belong to their owners.</string>

    <!-- Privacy -->
    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_updated">Last updated: November 10, 2026</string>
    <string name="privacy_intro">F7 Download Manager is a local app that does not require an account. This policy explains what data is processed and how.</string>
    <string name="privacy_section_data">Data processed</string>
    <string name="privacy_data_desc">URLs, file names, sizes, progress, optional checksums, and settings are stored only on your device. Download history lives in the app database.</string>
    <string name="privacy_section_network">Network connections</string>
    <string name="privacy_network_desc">F7 connects directly to the servers you download from or visit in the browser. Cookies and referer from the browser are forwarded only for downloads you start. There is no F7 relay server.</string>
    <string name="privacy_section_ads">Ads and analytics</string>
    <string name="privacy_ads_desc">There are no ads, analytics SDKs, tracking, or data sales. The app does not request location, contacts, or microphone permissions.</string>
    <string name="privacy_section_storage">Storage</string>
    <string name="privacy_storage_desc">Files are stored in the folder you choose through MediaStore or the Storage Access Framework. You can delete them anytime from the app or a file manager.</string>
    <string name="privacy_section_contact">Contact</string>
    <string name="privacy_contact_desc">For privacy questions, open the project page and file an issue. No data is automatically collected by the developer.</string>

